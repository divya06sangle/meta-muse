# Meta Muse API Configuration
# Get your API key from Meta Developer Dashboard (dev.meta.ai / developer.meta.com)
META_API_KEY=your_meta_api_key_here

# Meta Model API Base URL (OpenAI SDK compatible endpoint)
META_BASE_URL=https://api.meta.ai/v1

# Default Model (options: muse-spark-1.3, muse-spark-1.1, muse-image)
META_DEFAULT_MODEL=muse-spark-1.3

# Local Server Port
PORT=3000
